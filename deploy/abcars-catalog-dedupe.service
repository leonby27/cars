[Unit]
Description=Скрыть межисточниковые дубли каталога, сохранив карточки в базе
After=network-online.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/srv/abcars
EnvironmentFile=/srv/abcars/.env.local
ExecStart=/usr/bin/node scripts/deduplicate-cross-source.mjs --apply
TimeoutStartSec=300
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=abcars-catalog-dedupe
