[Unit]
Description=Подготовка исходников и публикация в соцсети
After=network-online.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/srv/abcars
EnvironmentFile=/srv/abcars/.env.local
Environment=TZ=Europe/Minsk
ExecStart=/usr/bin/npm run social:week:run
TimeoutStartSec=1800
Nice=10
CPUWeight=30
IOWeight=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=abcars-social-week

