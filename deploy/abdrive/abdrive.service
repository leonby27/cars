[Unit]
Description=ABDrive Russian catalog
After=network.target postgresql.service

[Service]
Type=simple
User=abdrive
Group=abdrive
WorkingDirectory=/srv/abdrive/current
EnvironmentFile=/etc/abdrive/environment
ExecStart=/usr/bin/node server/abdrive/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=768M
Environment=NODE_OPTIONS=--max-old-space-size=512
Environment=ABDRIVE_PRICE_INDEX_FILE=/var/cache/abdrive/price-index.json
CacheDirectory=abdrive
CPUQuota=50%
Nice=10
UMask=0077

[Install]
WantedBy=multi-user.target
