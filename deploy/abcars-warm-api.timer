# Каждые десять минут. Готовый ответ каталога живёт пятнадцать, поэтому запись не
# успевает пропасть между заходами, и холодный ответ не достаётся посетителю даже
# в самые тихие часы. Проход дешёвый — два десятка мелких запросов к своему же сайту.
[Unit]
Description=Прогрев кэша данных каталога каждые десять минут

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
