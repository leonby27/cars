[Unit]
Description=Permanent full galleries of viewed vehicles
After=network-online.target nginx.service postgresql.service

[Service]
Type=simple
WorkingDirectory=/srv/abcars
EnvironmentFile=/srv/abcars/.env.local
ExecStart=/usr/bin/flock -n /srv/abcars/runtime/photo-store/galleries.lock /usr/bin/node /opt/abcars-photo-store/scripts/store-viewed-galleries.mjs
Restart=on-failure
RestartSec=300
TimeoutStopSec=90
Nice=15
CPUWeight=20
IOWeight=20
MemoryHigh=300M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
