# Первое число каждого квартала: 1 января, 1 апреля, 1 июля и 1 октября.
# Время в UTC, на сервере оно и стоит: 06:00 UTC — это 09:00 по Минску.
# Persistent=true: если сервер в этот момент был выключен, напоминание придёт,
# как только он поднимется, а не пропадёт до следующего квартала.
[Unit]
Description=Напоминание обновить сравнение цен раз в квартал

[Timer]
OnCalendar=*-01,04,07,10-01 06:00:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
