# После всей ночной работы: актуализация идёт с 01:00, пополнение с 05:00, сводка
# в телеграм в 06:00. К 06:20 UTC (09:20 в Минске) за ночь уже всё известно, и
# список изменений уходит поисковикам одним запросом.
[Unit]
Description=Отправка изменений в IndexNow раз в сутки

[Timer]
OnCalendar=*-*-* 06:20:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
