# Ночь на воскресенье, 04:30 UTC (07:30 в Минске): актуализация каталога к этому
# времени уже прошла, а утренняя сводка ещё не ушла. День недели постоянный —
# индекс считается неделя к неделе, и снимки должны стоять ровно через семь дней.
# Persistent=true: если сервер в это время был выключен, снимок сделается при
# первом запуске, а не пропустит неделю.
[Unit]
Description=Снимок цен каталога раз в неделю

[Timer]
OnCalendar=Sun *-*-* 04:30:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
