# Материалы выходят утром, но в разное время: 09:30–11:30 по Минску, каждый день
# заново. Ровный час выдавал бы автоматику; разброс делает выкладку похожей на
# человека, который сел за компьютер и опубликовал статью.
#
# Время выбрано после всей ночной работы: актуализация каталога идёт до 05:30 UTC,
# пополнение с 05:00, сводка в телеграм в 06:00, рассылка поисковикам в 06:20.
[Unit]
Description=Утренняя выкладка материалов журнала

[Timer]
OnCalendar=*-*-* 06:30:00
RandomizedDelaySec=7200
Persistent=true

[Install]
WantedBy=timers.target
