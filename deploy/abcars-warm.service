# Прогрев кэша фотографий: заранее просим у своего же сайта первый снимок каждой
# машины каталога, чтобы наш сервер забрал их у китайского хранилища до прихода
# посетителей. Витрине главной может достаться любая карточка, поэтому греем все.
# Что и зачем — в шапке scripts/warm-photos.mjs. Ставится на сервер так:
#   install -m644 /srv/abcars/deploy/abcars-warm.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now abcars-warm.timer
[Unit]
Description=Прогрев кэша фотографий машин
After=network-online.target nginx.service postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/srv/abcars
EnvironmentFile=/srv/abcars/.env.local
ExecStart=/usr/bin/npm run warm -- --all --concurrency=10
# Полный проход греет три размера первого снимка: исходник продавца для большого фото
# в карточке машины, 900 для карточки списка на компьютере и 600 для телефона. После
# смены размеров первый проход качает у хранилища около 12 ГБ и идёт часов пять; дальше
# почти всё берётся из своей же копии и проход занимает минуты. Потоков десять вместо
# шести: скрипт почти всё время ждёт ответа из Китая, а не считает.
TimeoutStartSec=43200
Nice=15
CPUWeight=20
IOWeight=20
MemoryHigh=500M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=abcars-warm
