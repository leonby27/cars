[Unit]
Description=Удаление фото через семь дней после снятия объявления
After=postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/srv/abcars
EnvironmentFile=/srv/abcars/.env.local
ExecStart=/usr/bin/flock -n /srv/abcars/runtime/photo-store/cleanup.lock /usr/bin/node /opt/abcars-photo-store/scripts/cleanup-catalog-photos.mjs --apply
Nice=15
CPUWeight=20
IOWeight=20
# Список всех файлов и адресов фото занимает около гигабайта; при 300 МБ node сам
# урезал себе память под этот предел и 27.09.2026 падал, ничего не удалив.
Environment=NODE_OPTIONS=--max-old-space-size=1536
MemoryHigh=2G
TimeoutStartSec=30min
