{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com https://*.yandex.ru https://yastatic.net wss://mc.yandex.ru wss://mc.yandex.com; frame-src 'self' https://yandex.ru https://*.yandex.ru https://yandex.by https://*.yandex.by; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/how-it-works",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path"
    },
    {
      "source": "/orders/:path*",
      "destination": "/private"
    },
    {
      "source": "/cars/:id",
      "destination": "/api?path=pages/car&id=:id"
    },
    {
      "source": "/catalog",
      "destination": "/api?path=pages/catalog"
    },
    {
      "source": "/catalog/:slug",
      "destination": "/api?path=pages/catalog&slug=:slug"
    },
    {
      "source": "/models/:slug",
      "destination": "/api?path=pages/model&slug=:slug"
    },
    {
      "source": "/analytics",
      "destination": "/analytics/index.html"
    }
  ]
}
