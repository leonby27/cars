{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path"
    },
    {
      "source": "/orders/:path*",
      "destination": "/private.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics/index.html"
    }
  ]
}
