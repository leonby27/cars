# Optional: interval for the long-running importer, in milliseconds. Default: 6 hours.
GUAZI_SYNC_INTERVAL_MS=21600000
GUAZI_IMPORT_LIMIT=60
GUAZI_IMPORT_SCAN=2500
GUAZI_DISCOVERY=targeted

# User agent used for the index-oriented HTML representation containing the original gallery.
GUAZI_HTML_USER_AGENT=OAI-SearchBot/1.0
# Optional approved egress and browser session. Never commit real credentials.
GUAZI_PROXY_URL=
# Optional comma-separated pool; the worker automatically fails over.
GUAZI_PROXY_URLS=
# Advanced pool: [{"name":"cn-1","proxyUrl":"http://user:pass@host:port","cookie":"..."}]
GUAZI_CHANNELS_JSON=[]
GUAZI_ALLOW_DIRECT=true
GUAZI_COOKIE=

# Local catalog API and PostgreSQL. docker-compose.yml uses these defaults.
DATABASE_URL=postgres://chinacar:chinacar@127.0.0.1:54329/chinacar
API_PORT=8787
DB_POOL_SIZE=12
CRAWL_SCHEDULE_INTERVAL_MS=900000
CRAWL_EXPIRE_INTERVAL_MS=86400000

# SEO stays disabled on preview/test domains. Enable only after SITE_URL points
# to the real production domain and its DNS/HTTPS are ready.
SITE_URL=https://evcars.by
SEO_ALLOW_INDEXING=false

# Protects /analytics. Use a long unique password in every deployed environment.
ANALYTICS_PASSWORD=
# Optional independent signing secret for the 12-hour analytics session cookie.
ANALYTICS_SESSION_SECRET=
