# Optional: interval for the long-running importer, in milliseconds. Default: 6 hours.
GUAZI_SYNC_INTERVAL_MS=21600000
GUAZI_IMPORT_LIMIT=60
GUAZI_IMPORT_SCAN=2500
GUAZI_DISCOVERY=targeted

# User agent used for the index-oriented HTML representation containing the original gallery.
GUAZI_HTML_USER_AGENT=OAI-SearchBot/1.0
