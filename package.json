{
  "name": "abcars-mvp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run api:watch\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:all": "concurrently -k -n api,crawler,web -c blue,yellow,magenta \"npm run api:watch\" \"npm run worker\" \"npm run dev:web\"",
    "api": "node server/index.mjs",
    "api:watch": "node --watch server/index.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "rates": "node scripts/update-rates.mjs",
    "quota": "node scripts/update-ev-quota.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import": "node scripts/db-import-json.mjs",
    "db:discover": "node scripts/import-guazi.mjs --database-only",
    "db:expire": "node scripts/db-expire.mjs",
    "db:estimates": "node scripts/backfill-estimates.mjs",
    "db:engine": "node scripts/backfill-engine.mjs",
    "db:bodies": "node scripts/fix-body-types.mjs",
    "db:models": "node scripts/fix-model-names.mjs",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:import",
    "db:schedule": "node scripts/db-schedule.mjs",
    "db:staff": "node scripts/db-staff.mjs",
    "worker": "node scripts/db-worker.mjs",
    "worker:once": "node scripts/db-worker.mjs --once",
    "build": "vite build && node scripts/generate-seo-pages.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "import:guazi": "node scripts/import-guazi.mjs",
    "import:guazi-global": "node scripts/import-guazi-global.mjs",
    "importv2": "node scripts/import-v2.mjs",
    "refresh": "node scripts/refresh-che168.mjs",
    "import:watch": "node scripts/watch-guazi.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "undici": "^8.10.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "playwright": "^1.62.1"
  }
}
